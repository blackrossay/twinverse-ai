# Copy to .env and fill in. Never commit real keys.
# Get a key: Meta Model API dashboard -> API keys -> Create API key
# (Hackathon accounts include credits; see docs/DECISIONS.md)
MODEL_API_KEY=
# Optional: additional dashboard keys (comma-separated) rotated in on 401/429
MODEL_API_KEY_FALLBACKS=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_SIM=muse-spark-1.3
META_MODEL_EVAL=muse-spark-1.3
META_MODEL_IMAGE=muse-image-1.0
# Optional: voice input is not implemented in this build
# META_MODEL_ASR=muse-voice-transcribe-1.0

# Local runtime (defaults shown)
TWINVERSE_DB_PATH=data/twinverse.db
TWINVERSE_CARD_DIR=data/cards

# Labeled offline fixtures when no key is present (demo/dev only, never submitted as live output)
TWINVERSE_FIXTURES=auto

# Talking verdicts: your clone speaks verdicts in-app. See docs/AVATAR.md.
# Likeness (your photo + voice) uploads via the UI, never via env.
TWINVERSE_AVATAR_DIR=data/avatars
TWINVERSE_OPENVOICE_CKPT=models/openvoice_v2
# Optional CUDA-only true lip-sync: path to a MuseTalk checkout (blank = animated portrait)
TWINVERSE_MUSETALK_REPO=
# Inference placement (production): local = render on this machine (dev only);
# http = render on your cloud inference service (customers install nothing).
TWINVERSE_AVATAR_PROVIDER=local
TWINVERSE_INFERENCE_URL=
TWINVERSE_INFERENCE_TOKEN=
# Accounts (production): require bearer tokens from /api/auth/signup|login
TWINVERSE_AUTH_REQUIRED=false
TWINVERSE_AUTH_SECRET=
